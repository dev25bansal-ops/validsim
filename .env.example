# =============================================================================
# ValidSim — environment template
#
# Copy to `.env` and adjust for your machine:
#
#     cp .env.example .env        # (Windows / PowerShell: Copy-Item .env.example .env)
#
# Docker Compose automatically loads `.env` from this directory and uses it to
# interpolate the ${VAR} references in docker-compose.yml (notably
# POSTGRES_PASSWORD and VALIDSIM_STORE). The same variables are read directly
# by the application (API, CLI, worker) via os.environ, so one file drives both.
#
# ALL VALUES BELOW ARE DEV-SAFE PLACEHOLDERS — never commit a real `.env`.
# `.env` and `.env.*` are git-ignored; this `.env.example` template is meant to
# be committed. Rotate every secret before any non-local deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (the `postgres` compose service + the validation store)
# -----------------------------------------------------------------------------

# REQUIRED by docker-compose.yml. Compose aborts with "set POSTGRES_PASSWORD"
# if this is unset or empty. It is interpolated into the postgres container's
# POSTGRES_PASSWORD and into the VALIDSIM_PG_URL DSN below. Use a real, strong
# value outside local development.
POSTGRES_PASSWORD=validsim-dev-password

# Validation-store backend: memory | sqlite | postgres  (default: memory).
# The compose stack ships postgres, so the api/worker services default to it.
# `memory` keeps local CLI runs side-effect free.
VALIDSIM_STORE=postgres

# Full libpq/psycopg DSN used when VALIDSIM_STORE=postgres.
#   - Inside the compose network the host is `postgres`.
#   - From the host machine (running the CLI/API directly) use `localhost`.
# docker-compose.yml builds this DSN itself from POSTGRES_PASSWORD; set it here
# only when running the app OUTSIDE compose. Do NOT append `?sslmode=require`
# against the stock postgres:16-alpine image (SSL is disabled → all conns fail).
VALIDSIM_PG_URL=postgresql://validsim:validsim-dev-password@localhost:5432/validsim

# SQLite database path, used only when VALIDSIM_STORE=sqlite (default: validsim.db).
VALIDSIM_SQLITE_PATH=validsim.db

# -----------------------------------------------------------------------------
# Job queue (async validation jobs consumed by the `worker` service)
# -----------------------------------------------------------------------------

# Queue backend: memory | redis  (default: memory).
# Set to `redis` so `validsim job enqueue` / the API and the `worker` share one queue.
VALIDSIM_JOB_QUEUE=redis

# Redis connection URL.
#   - Inside compose the host is `redis` (the api/worker services hardcode this).
#   - From the host machine use `localhost` (postgres/redis publish on 127.0.0.1).
VALIDSIM_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# API hardening (read once at app startup by validsim.api.main:create_app)
# -----------------------------------------------------------------------------

# When set, every /api/v1 route requires a matching `X-API-Key` header (401
# otherwise). LEAVE EMPTY FOR LOCAL DEV — unset disables auth entirely, which
# is what the test suite and quickstarts expect. Set a long random secret in prod.
VALIDSIM_API_KEY=

# Comma-separated CORS origin allow-list (default: "*" = allow-all).
# Tighten to explicit origins before exposing the API beyond localhost,
# e.g. VALIDSIM_CORS_ORIGINS=https://dashboard.example.com
VALIDSIM_CORS_ORIGINS=*

# Per-client request budget for write/sensitive routes, over the window below.
# 0 disables rate limiting (the default, preserves open-dev behavior).
VALIDSIM_RATE_LIMIT=0

# Sliding-window length in seconds for VALIDSIM_RATE_LIMIT (default: 60).
VALIDSIM_RATE_WINDOW_SECONDS=60

# Runtime label consumed by the app/compose (informational): development | production.
VALIDSIM_ENV=development

# -----------------------------------------------------------------------------
# Simulation backend (validsim.sim:create_backend)
# -----------------------------------------------------------------------------

# Backend: mock | isaac  (default: mock).
# `mock` is the deterministic, CPU-only, GPU-free backend used by the compose
# stack, the test suite, and the `worker` service. Switch to `isaac` only when a
# real GPU Isaac Sim/Lab worker is reachable at VALIDSIM_ISAAC_WORKER_URL below.
VALIDSIM_BACKEND=mock

# -----------------------------------------------------------------------------
# GPU Isaac Sim worker (only used when VALIDSIM_BACKEND=isaac)
# -----------------------------------------------------------------------------

# Base URL of the containerized Isaac Sim/Lab GPU worker that runs each episode.
# Unused under the mock backend. Point at the worker-gpu service once it exists.
VALIDSIM_ISAAC_WORKER_URL=http://localhost:8080

# Bearer token sent to the Isaac worker. Leave empty for local dev; the worker
# only enforces it if configured to. Use a strong secret in prod.
VALIDSIM_ISAAC_WORKER_KEY=

# -----------------------------------------------------------------------------
# LLM adversarial-scenario generation (validsim.scenarios.llm_generator)
# -----------------------------------------------------------------------------

# OpenAI-compatible chat endpoint (default: https://api.openai.com/v1).
# Override for a self-hosted / Azure / local gateway.
VALIDSIM_LLM_BASE_URL=https://api.openai.com/v1

# Bearer API key for the LLM endpoint. LEAVE EMPTY FOR LOCAL DEV — when unset,
# the LLM scenario provider is disabled and generation falls back to the
# deterministic built-in generator. Set a real key to enable LLM scenarios.
VALIDSIM_LLM_API_KEY=

# Chat model name (default: gpt-4o-mini).
VALIDSIM_LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Notifications: webhooks + email
# -----------------------------------------------------------------------------

# Webhook delivery mode. Default (unset / 0) is DRY-RUN: no network I/O, safe
# for tests and local runs. Set to 1 to POST completed scorecards live to
# registered webhook endpoints.
VALIDSIM_WEBHOOKS_LIVE=0

# SMTP settings for email scorecard delivery. All optional — email is skipped
# when VALIDSIM_SMTP_HOST is unset.
VALIDSIM_SMTP_HOST=            # e.g. smtp.example.com
VALIDSIM_SMTP_PORT=587         # default 587 (submission)
VALIDSIM_SMTP_USER=            # optional AUTH username
VALIDSIM_SMTP_PASSWORD=        # optional AUTH password — secret, never commit
VALIDSIM_SMTP_FROM=            # sender (From) address, e.g. validsim@example.com
VALIDSIM_SMTP_TLS=1            # set to 0 to disable STARTTLS (default: on)

# -----------------------------------------------------------------------------
# CLI / config loading (optional)
# -----------------------------------------------------------------------------

# Path to an explicit config file (equivalent to `--config`); otherwise defaults apply.
VALIDSIM_CONFIG=

# Directory that all asset paths (URDF / USD) resolve beneath. Must contain the
# referenced assets; path-traversal outside it is rejected. Defaults to the CWD.
VALIDSIM_ASSET_ROOT=

# Local scorecard cache file used by `validsim run|status|scorecard|gate`
# (default: .validsim/scorecards.json).
VALIDSIM_CACHE_FILE=
