---
import { site } from '../data/content';
---

<section class="band" id="contact">
  <div class="wrap">
    <div class="close reveal">
      <h2>We want the teams deploying robot models today</h2>
      <p>
        Not investors and not pilots — actual conversations. If you ship a robot model and have no
        way to regression-test it before a fleet, tell us how you handle that today. We will show you
        the tool and be honest about what it cannot do yet.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn btn-quiet" href={site.github} rel="noopener">View the code</a>
      </div>
    </div>
  </div>
</section>
