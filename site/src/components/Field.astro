---
/**
 * Competitive landscape. Names the real threats rather than claiming an empty
 * field — "no competitors" reads as naive to a technical reviewer.
 */
import { competitors } from '../data/content';
---

<section class="band" id="field">
  <div class="wrap">
    <div class="band-head reveal">
      <p class="fig-label">Fig 0.5 — the field</p>
      <h2>Most robot tooling sits after deployment</h2>
      <p>
        We are aimed at the gap before it. This is our read of the landscape as of September 2026,
        including the parts that are threats to us.
      </p>
    </div>

    <div class="scroll-x reveal" role="region" aria-label="Competitive landscape, scrollable">
      <table>
        <thead>
          <tr>
            <th scope="col">Player</th>
            <th scope="col">What they actually do</th>
            <th scope="col">Relation</th>
          </tr>
        </thead>
        <tbody>
          {
            competitors.map((row) => (
              <tr>
                <th scope="row">{row.name}</th>
                <td>{row.does}</td>
                <td>
                  <span class={`pill pill-${row.tone}`}>{row.relation}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .scroll-x {
    overflow-x: auto;
    border-block-start: 1px solid var(--rule);
    /* A horizontally scrollable region is a keyboard trap unless it is itself
       focusable: a keyboard user cannot reach the columns that are cut off. */
    tabindex: 0;
  }
  .scroll-x:focus-visible {
    outline: 2px solid var(--unmeasured);
    outline-offset: 3px;
  }
  table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
    min-inline-size: 36rem;
  }
  th,
  td {
    padding: 1rem 1.25rem 1rem 0;
    text-align: start;
    border-block-end: 1px solid var(--rule);
    vertical-align: top;
  }
  thead th {
    font-family: var(--mono);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  tbody th {
    font-weight: 500;
    white-space: nowrap;
    padding-inline-end: 2rem;
  }
  tbody td {
    color: var(--ink-mid);
  }
  td:last-child,
  th:last-child {
    padding-inline-end: 0;
  }
  .pill {
    font-family: var(--mono);
    font-size: var(--t-xs);
    white-space: nowrap;
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }
  .pill-us {
    color: var(--approve);
    background: color-mix(in oklch, var(--approve) 12%, transparent);
  }
  .pill-them {
    color: var(--ink-dim);
    background: color-mix(in oklch, var(--ink-dim) 10%, transparent);
  }
  .pill-part {
    color: var(--link);
    background: color-mix(in oklch, var(--link) 12%, transparent);
  }
</style>
